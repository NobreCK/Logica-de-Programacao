    if (altura) {
        // Se altura for true, calcula o centro vertical da tela (128 / 2 = 64) e desconta a letra
        y = (tft.height() / 2) - (alturatexto / 2);
    }

    tft.setTextSize(tamanho);
    tft.setCursor(x, y);
    tft.print(texto);

    if (sublinhar) {
        int yLinha = y + alturatexto + 1;
        // Corrigido para drawFastHLine (o drawline original pedia coordenadas finais X,Y)
        tft.drawFastHLine(x, yLinha, larguraTexto, ST7735_WHITE);
    }
    tft.setTextSize(1); // Reseta a fonte para o padrão
}

void carregarmenus() {
    const char* const* menuItens;
    
    switch (estadoatual) {
        case REDES:
            menuItens = menuRedes;
            break;
        case INFRAVERMELHO:
            menuItens = menuInfravermelho;
            break;
        default:
            return;
    }
    tft.fillRect(6, 18, tft.width() - 12, tft.height() - 28, ST7735_BLACK); // ✅ limpa só a área do conteúdo
    for (int i = 0; i < totalitens; i++) {
        int distancia = i - itemselecionado;

        if (i == itemselecionado) {
            tft.setTextColor(ST7735_WHITE); // 💡 Garante que o selecionado seja sempre BRANCO
            printCentro(menuItens[i], 0, 2, true, true); // Centraliza X e Y automaticamente
        }
        else {    
            // 💡 Pegamos o meio real da tela e aplicamos o seu cálculo de distância perfeito!
            int ycalculado = (tft.height() / 2) + (distancia * 24); 
            
            // Como os itens menores (tam 1) começam o desenho pelo topo da letra, 
            // precisamos recuar 4 pixels (metade de 8) para que o MEIO do texto menor 
            // alinhe com a linha do ycalculado!
            ycalculado = ycalculado - 4;

            if (ycalculado > 15 && ycalculado < 115) {
                tft.setTextColor(0x7BEF); // Cor cinza escura
                // 💡 MUDADO PARA FALSE: Usa o ycalculado que você descobriu com tanto esforço!
                printCentro(menuItens[i], ycalculado, 1, false, false); 
            }
        }
    }
}

void desenharIconeComEscala(int16_t x, int16_t y, const unsigned char *bitmap, int16_t w, int16_t h, uint16_t col, uint8_t escala) {
    int16_t i, j, byteWidth = (w + 7) / 8;
    uint8_t b = 0;

    for (j = 0; j < h; j++) {
        for (i = 0; i < w; i++) {
            if (i & 7) b <<= 1;
            else b = pgm_read_byte(&bitmap[j * byteWidth + i / 8]);
            
            if (b & 0x80) {
                tft.fillRect(x + (i * escala), y + (j * escala), escala, escala, col);
            }
        }
    }
}



