    pinMode(btnDown, INPUT_PULLUP);

    tft.initR(INITR_BLACKTAB); 
    tft.setRotation(1); 
    tft.setTextSize(1); 
    
    tft.fillScreen(ST7735_BLACK); 
    
    iniciarTopo();
    desenharInterfaceCarrossel();
}

